    },
    "chatgpt": {
      "name": "ChatGPT / OpenAI",
      "output": "rules/ai/ChatGPT.list",
      "mode": "filtered",
      "listSources": ["meta_openai", "sukka_ai", "rabbit_ai"],
      "allowed_suffixes": ["openai.com", "openai.org", "chatgpt.com", "chat.com", "oaistatic.com", "oaiusercontent.com", "oaistatsig.com", "chatgpt.livekit.cloud", "openai.com.cdn.cloudflare.net"],
