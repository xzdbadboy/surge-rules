    "muse": {
      "name": "Muse",
      "output": "rules/ai/Muse.list",
      "mode": "filtered",
      "listSources": [],
      "allowed_suffixes": [],
      "allowed_domains": [],
      "local_rules": [
        "PROCESS-NAME,/Applications/Muse.app/"
