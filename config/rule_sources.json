      "local_rules": [],
      "description": "ChatGPT web, OpenAI API and dedicated assets; Sora is a separate list. Shared payment, CAPTCHA and telemetry providers excluded.",
      "evidence": ["https://help.openai.com/en/articles/9247338-network-recommendations-for-chatgpt-errors-on-web-and-apps"]
    },
    "claude": {
      "name": "Claude / Anthropic / Claude Code",
